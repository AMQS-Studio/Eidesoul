        "(?i)\\b(password\\w{0,2}|passwd|kata\\s+sandi)\\b\\s*(?:[:=]\\s*)?\\S+",
        "(?i)\\b(password|passwd|kata\\s+sandi|sandi|api[\\s_-]?key|kunci\\s+api|token|secret|rahasia)\\b\\s*[:=]\\s*\\S+",
        "(?i)(?<![A-Za-z0-9])(-----BEGIN [A-Z ]+PRIVATE KEY-----)"
      ],
      "examples": [
        "passwordku adalah hunter2",
        "api key: sk-abc",
        "kata sandi saya rahasia"
      ]
    },
